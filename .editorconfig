# Thống nhất định dạng giữa các IDE (IntelliJ, STS, VS Code đều đọc file này).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# 2 dấu cách cuối dòng trong Markdown = xuống dòng, không được xóa
trim_trailing_whitespace = false
